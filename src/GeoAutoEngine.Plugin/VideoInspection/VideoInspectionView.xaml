<UserControl x:Class="GeoAutoEngine.Plugin.VideoInspection.VideoInspectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="560" MinHeight="480"
             Background="#17212B"
             Foreground="#EEF4F7">
  <UserControl.Resources>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Background" Value="#1E90C2" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>
  <Grid Margin="18">
    <Grid Visibility="{Binding EmptyVisibility}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
        <TextBlock Text="VÍDEO-INSPEÇÃO" FontSize="24" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,0,0,22" />
        <TextBlock Text="Nenhuma inspeção carregada." FontSize="17"
                   HorizontalAlignment="Center" Margin="0,0,0,12" />
        <TextBlock Text="O GeoAutoDocs pode enviar uma inspeção automaticamente para este módulo."
                   Foreground="#B5C5CE" TextAlignment="Center" Margin="0,0,0,24" />
        <Button Content="IMPORTAR ARQUIVO DE INSPEÇÃO" Command="{Binding ImportCommand}"
                HorizontalAlignment="Center" />
        <TextBlock Text="Formato de fallback: .geoadocs.json" Foreground="#8296A3"
                   HorizontalAlignment="Center" Margin="0,8,0,0" />
      </StackPanel>
    </Grid>

    <Grid Visibility="{Binding InspectionVisibility}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#22313D" CornerRadius="5" Padding="14" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding Notification}" Foreground="#75C84B" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ReportCode}" FontSize="21" FontWeight="Bold" Margin="0,4,0,0" />
            <TextBlock Text="{Binding ReportName}" Foreground="#C6D2D9" />
            <TextBlock Foreground="#A9B8C5" Margin="0,5,0,0">
              <Run Text="{Binding Client, Mode=OneWay}" /><Run Text="  •  " /><Run Text="{Binding Area, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding ReportSummary}" Foreground="#75C84B" Margin="0,5,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Content="IMPORTAR" Command="{Binding ImportCommand}"
                  VerticalAlignment="Top" />
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" MinWidth="210" />
          <ColumnDefinition Width="3*" MinWidth="300" />
        </Grid.ColumnDefinitions>
        <ListBox Grid.Column="0" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                 Background="#111A22" Foreground="#EEF4F7" BorderBrush="#354957" Margin="0,0,10,0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="5">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Route}" Foreground="#A9B8C5" FontSize="11" />
                <TextBlock>
                  <Run Text="{Binding StatusText, Mode=OneWay}" /><Run Text="   " />
                  <Run Text="{Binding Diameter, Mode=OneWay}" Foreground="#75C84B" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1" Background="#111A22" BorderBrush="#354957" BorderThickness="1"
                Padding="12" Visibility="{Binding SelectedSectionVisibility}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding SelectedSection.Name}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedSection.Route}" Foreground="#A9B8C5" />
              <TextBlock Margin="0,6,0,0">
                <Run Text="Diâmetro: " /><Run Text="{Binding SelectedSection.Diameter, Mode=OneWay}" />
                <Run Text="   Investigado: " /><Run Text="{Binding SelectedSection.InvestigatedMeters, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Margin="0,4,0,0">
                <Run Text="Direction: " /><Run Text="{Binding SelectedSection.Direction, Mode=OneWay}" />
                <Run Text="   Comprimento CAD: " /><Run Text="{Binding SelectedSection.CadLength, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Margin="0,4,0,0" Foreground="#75C84B">
                <Run Text="Ocorrências posicionadas: " />
                <Run Text="{Binding SelectedSection.PositionedOccurrences, Mode=OneWay}" />
                <Run Text="   Requerem atenção: " />
                <Run Text="{Binding SelectedSection.AttentionOccurrences, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Text="{Binding SelectedSection.Reference}" Foreground="#A9B8C5" />
              <TextBlock Text="{Binding SelectedSection.StatusMessage}" Foreground="#FFB347" />
            </StackPanel>
            <ListView Grid.Row="1" ItemsSource="{Binding SelectedSection.Occurrences}"
                      Background="Transparent" Foreground="#EEF4F7" BorderThickness="0" Margin="0,10,0,8">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Posição" Width="125" DisplayMemberBinding="{Binding Position}" />
                  <GridViewColumn Header="Ocorrência" Width="250" DisplayMemberBinding="{Binding Description}" />
                </GridView>
              </ListView.View>
            </ListView>
            <StackPanel Grid.Row="2">
              <TextBlock Text="{Binding PositioningSummary}" Foreground="#FFB347" Margin="4" />
              <WrapPanel>
                <Button Content="ASSOCIAR GEOMETRIA" Command="{Binding AssociateCommand}" />
                <Button Content="GERAR NO DESENHO" Command="{Binding CommitCommand}" Background="#4C9B3A" />
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
