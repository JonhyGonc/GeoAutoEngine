<UserControl x:Class="GeoAutoEngine.Plugin.VideoInspection.VideoInspectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="300" MinHeight="420" Background="#080E1A">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/GeoAutoTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="StatusBadgeText" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="OccurrenceCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="BorderThickness" Value="3,1,1,1" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RequiresAttention}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AttentionBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid Visibility="{Binding EmptyVisibility}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="260">
                <Border Width="42" Height="42" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="9" Margin="0,0,0,12">
                    <Grid>
                        <Path Data="M 4,1 L 12,1 L 17,6 L 17,21 L 4,21 Z M 12,1 L 12,6 L 17,6"
                              Stroke="{StaticResource VeryMutedBrush}" StrokeThickness="1.4"
                              Fill="Transparent" Stretch="Uniform" Width="18" Height="22" />
                        <TextBlock Text="+" Foreground="{StaticResource VeryMutedBrush}" FontSize="13"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,7,5" />
                    </Grid>
                </Border>
                <TextBlock Text="Nenhum arquivo JSON carregado." Foreground="{StaticResource VeryMutedBrush}"
                           FontSize="12" TextAlignment="Center" Margin="0,0,0,14" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}"
                        Content="⇧  Importar inspeção" />
            </StackPanel>
        </Grid>

        <Grid Visibility="{Binding InspectionVisibility}">
            <Grid x:Name="ListState">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="12,12,12,8" Padding="13">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="INSPEÇÃO RECEBIDA" Style="{StaticResource AccentSectionLabel}" />
                                            <Ellipse Width="4" Height="4" Fill="{StaticResource SuccessBrush}"
                                                     Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ReportCode}" Style="{StaticResource MonoText}"
                                                   Foreground="{StaticResource LabelBrush}" FontSize="11" Margin="0,6,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Client}" Foreground="{StaticResource ForegroundSecondaryBrush}"
                                                   FontSize="12" FontWeight="Medium" Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Border Background="Transparent" BorderBrush="{StaticResource BorderEmphasisBrush}"
                                                BorderThickness="1" CornerRadius="7" Padding="8,7" Margin="0,0,6,0">
                                            <TextBlock Text="⌫ .json" Style="{StaticResource MonoText}"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                        </Border>
                                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}"
                                                Padding="10,7" FontSize="11" Content="⇧ Importar" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,10,0,9" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SectionCount}" Style="{StaticResource MonoText}"
                                               FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text=" trechos" Foreground="{StaticResource LabelBrush}" FontSize="11"
                                               VerticalAlignment="Bottom" Margin="2,0,0,1" />
                                    <TextBlock Text="·" Foreground="{StaticResource VeryMutedBrush}" Margin="12,0" />
                                    <TextBlock Text="{Binding OccurrenceCount}" Style="{StaticResource MonoText}"
                                               FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text=" ocorrências" Foreground="{StaticResource LabelBrush}" FontSize="11"
                                               VerticalAlignment="Bottom" Margin="2,0,0,1" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Margin="12,7,12,5">
                            <TextBlock Text="TRECHOS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Border Visibility="{Binding AssociatedCountVisibility}"
                                        Background="#1A22C55E" BorderBrush="#3322C55E" BorderThickness="1"
                                        CornerRadius="999" Padding="6,1" Margin="3,0">
                                    <TextBlock Text="{Binding AssociatedCount}" Style="{StaticResource MonoText}"
                                               FontSize="10" Foreground="{StaticResource SuccessBrush}" />
                                </Border>
                                <Border Visibility="{Binding PendingCountVisibility}"
                                        Background="#1AF59E0B" BorderBrush="#33F59E0B" BorderThickness="1"
                                        CornerRadius="999" Padding="6,1" Margin="3,0">
                                    <TextBlock Text="{Binding PendingCount}" Style="{StaticResource MonoText}"
                                               FontSize="10" Foreground="{StaticResource WarningBrush}" />
                                </Border>
                                <Border Visibility="{Binding AttentionCountVisibility}"
                                        Background="#1AF97316" BorderBrush="#33F97316" BorderThickness="1"
                                        CornerRadius="999" Padding="6,1" Margin="3,0">
                                    <TextBlock Text="{Binding AttentionCount}" Style="{StaticResource MonoText}"
                                               FontSize="10" Foreground="{StaticResource AttentionBrush}" />
                                </Border>
                                <Border Visibility="{Binding ErrorCountVisibility}"
                                        Background="#1AEF4444" BorderBrush="#33EF4444" BorderThickness="1"
                                        CornerRadius="999" Padding="6,1" Margin="3,0">
                                    <TextBlock Text="{Binding ErrorCount}" Style="{StaticResource MonoText}"
                                               FontSize="10" Foreground="{StaticResource ErrorBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <ListBox x:Name="SectionsList" ItemsSource="{Binding Sections}"
                                 SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                                 PreviewMouseLeftButtonUp="OpenSelectedSection"
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource ForegroundBrush}"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background" Value="#0D0EA5E9" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource SurfaceHoverBrush}" BorderThickness="0,0,0,1"
                                            Padding="12,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}"
                                                     VerticalAlignment="Center" HorizontalAlignment="Left" />
                                            <StackPanel Grid.Column="1" Margin="7,0,7,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                                    <Border HorizontalAlignment="Right" Background="{Binding StatusBackground}"
                                                            BorderBrush="{Binding StatusBorder}" BorderThickness="1"
                                                            CornerRadius="999" Padding="8,2">
                                                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource StatusBadgeText}"
                                                                   Foreground="{Binding StatusBrush}" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Style="{StaticResource MonoText}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0">
                                                    <Run Text="{Binding Route, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Diameter, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0">
                                                    <Run Text="{Binding OccurrenceSummary, Mode=OneWay}"/>
                                                    <Run Text="  ·  "/><Run Text="{Binding AttentionOccurrences, Mode=OneWay}"
                                                                            Foreground="{StaticResource AttentionBrush}"/>
                                                    <Run Text=" atenção" Foreground="{StaticResource AttentionBrush}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="›" Foreground="{StaticResource VeryMutedBrush}"
                                                       FontSize="19" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="DetailState" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Style="{StaticResource GhostButton}" Click="BackToSections"
                        HorizontalContentAlignment="Left" Padding="12,9"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                        Content="‹  Voltar aos trechos" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,14">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedSection.Name}" FontSize="15" FontWeight="Bold" />
                                        <TextBlock Text="{Binding SelectedSection.Route}" Style="{StaticResource MonoText}"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="{Binding SelectedSection.StatusBackground}"
                                            BorderBrush="{Binding SelectedSection.StatusBorder}" BorderThickness="1"
                                            CornerRadius="999" Padding="8,2">
                                        <TextBlock Text="{Binding SelectedSection.StatusLabel}"
                                                   Style="{StaticResource StatusBadgeText}"
                                                   Foreground="{Binding SelectedSection.StatusBrush}" />
                                    </Border>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,8,10">
                                        <TextBlock Text="DIÂMETRO" Style="{StaticResource SectionLabel}" Foreground="{StaticResource VeryMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedSection.Diameter}" Foreground="{StaticResource ForegroundSecondaryBrush}"
                                                   FontSize="13" FontWeight="Medium" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,10">
                                        <TextBlock Text="COMPRIMENTO" Style="{StaticResource SectionLabel}" Foreground="{StaticResource VeryMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedSection.CadLength}" Foreground="{StaticResource ForegroundSecondaryBrush}"
                                                   FontSize="13" FontWeight="Medium" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,0,8,0">
                                        <TextBlock Text="DIREÇÃO" Style="{StaticResource SectionLabel}" Foreground="{StaticResource VeryMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedSection.Direction}" Foreground="{StaticResource ForegroundSecondaryBrush}"
                                                   FontSize="13" FontWeight="Medium" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="OCORRÊNCIAS" Style="{StaticResource SectionLabel}" Foreground="{StaticResource VeryMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedSection.OccurrenceSummary}" Foreground="{StaticResource ForegroundSecondaryBrush}"
                                                   FontSize="13" FontWeight="Medium" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding SelectedSection.AlertVisibility}"
                                Background="{Binding SelectedSection.StatusBackground}"
                                BorderBrush="{Binding SelectedSection.StatusBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="12,9" Margin="0,10,0,12">
                            <TextBlock Text="{Binding SelectedSection.AlertMessage}"
                                       Foreground="{Binding SelectedSection.StatusBrush}" FontSize="12" />
                        </Border>

                        <Grid Margin="0,0,0,7">
                            <TextBlock Text="OCORRÊNCIAS" Style="{StaticResource SectionLabel}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Border Background="#1A22C55E" BorderBrush="#3322C55E" BorderThickness="1"
                                        CornerRadius="999" Padding="6,1" Margin="3,0">
                                    <TextBlock Style="{StaticResource StatusBadgeText}" Foreground="{StaticResource SuccessBrush}">
                                        <Run Text="{Binding SelectedSection.PositionedOccurrences, Mode=OneWay}"/><Run Text=" ok"/>
                                    </TextBlock>
                                </Border>
                                <Border Background="#1AF97316" BorderBrush="#33F97316" BorderThickness="1"
                                        CornerRadius="999" Padding="6,1" Margin="3,0">
                                    <TextBlock Style="{StaticResource StatusBadgeText}" Foreground="{StaticResource AttentionBrush}">
                                        <Run Text="{Binding SelectedSection.AttentionOccurrences, Mode=OneWay}"/><Run Text=" atenção"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding SelectedSection.Occurrences}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource OccurrenceCard}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Position}" Style="{StaticResource MonoText}"
                                                           Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Code}" HorizontalAlignment="Right"
                                                           Style="{StaticResource MonoText}" Foreground="{StaticResource MutedBrush}"
                                                           FontSize="10" />
                                            </Grid>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource LabelBrush}"
                                                       FontSize="12" LineHeight="18" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Card}"
                                Visibility="{Binding SelectedSection.OccurrencesEmptyVisibility}"
                                Padding="12,24">
                            <TextBlock Text="Nenhuma ocorrência neste trecho."
                                       Foreground="{StaticResource VeryMutedBrush}"
                                       TextAlignment="Center" />
                        </Border>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10,9">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedSection.PositionedOccurrences}" Style="{StaticResource MonoText}"
                                               Foreground="{StaticResource SuccessBrush}" FontSize="18" FontWeight="Bold" />
                                    <TextBlock Text="posicionadas" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10,9"
                                    BorderBrush="{Binding SelectedSection.StatusBorder}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedSection.AttentionOccurrences}" Style="{StaticResource MonoText}"
                                               Foreground="{StaticResource AttentionBrush}" FontSize="18" FontWeight="Bold" />
                                    <TextBlock Text="requer atenção" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,10">
                    <StackPanel>
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding AssociateCommand}"
                                Content="⌖  Associar geometria" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding CommitCommand}"
                                Margin="0,7,0,0" Content="⌁  GERAR NO DESENHO" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
